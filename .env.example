# Copy this file to .env and replace all password values before running Docker Compose.
POSTGRES_DB=cortexai
POSTGRES_USER=cortexai
POSTGRES_PASSWORD=ChangeThisDatabasePassword123!
POSTGRES_PORT=5432
WEB_PORT=8080

# Created when the application first starts. Change this password before deployment.
DEFAULT_ADMIN_EMAIL=admin@cortexai.local
DEFAULT_ADMIN_PASSWORD=ChangeThisAdminPassword123!
